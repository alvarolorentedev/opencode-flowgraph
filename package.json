{
  "name": "@alvarolorentedev/opencode-flowgraph",
  "version": "0.6.0",
  "description": "OpenCode V2 plugin for user-defined multi-agent YAML workflows with native agents, conditional routing, persistence, recovery, and generated Mermaid.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./contract": "./src/contract.ts",
    "./workflow": "./src/workflow/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "index.ts",
    "rpc.ts",
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "check": "bun run typecheck && bun run test",
    "test:smoke": "vitest run test/integration/opencode-smoke.test.ts",
    "prepublishOnly": "bun run check && bun run build:gui",
    "build:gui": "vite build --config vite.gui.config.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.32 <3",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "mermaid": "^11.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "workflow",
    "yaml",
    "mermaid",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarolorentedev/opencode-flowgraph.git"
  },
  "homepage": "https://github.com/alvarolorentedev/opencode-flowgraph#readme",
  "bugs": {
    "url": "https://github.com/alvarolorentedev/opencode-flowgraph/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
