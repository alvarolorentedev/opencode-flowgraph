{
  "name": "@alvarolorentedev/opencode-flowgraph",
  "version": "1.0.1",
  "description": "Portable multi-agent YAML workflow engine with an OpenCode adapter, standalone CLI, persistence, recovery, and Mermaid.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./contract": "./src/contract.ts",
    "./workflow": "./src/workflow/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./core": "./dist/core.js",
    "./runtime": "./dist/runtime.js",
    "./storage": "./dist/storage.js"
  },
  "bin": {
    "flowgraph": "./dist/cli.js"
  },
  "files": [
    "src",
    "index.ts",
    "rpc.ts",
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build:portable && bun run build:cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "check": "bun run typecheck && bun run test",
    "test:smoke": "vitest run test/integration/opencode-smoke.test.ts",
    "build:portable": "bun build src/core.ts --outfile dist/core.js --target node --format esm --packages external && bun build src/runtime/index.ts --outfile dist/runtime.js --target node --format esm --packages external && bun build src/storage/index.ts --outfile dist/storage.js --target node --format esm --packages external",
    "build:cli": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --packages external && chmod +x dist/cli.js",
    "build:gui": "vite build --config vite.gui.config.ts",
    "build": "bun run build:portable && bun run build:cli && bun run build:gui",
    "prepublishOnly": "bun run check && bun run build"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.32 <3",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true },
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "mermaid": "^11.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "workflow",
    "yaml",
    "mermaid",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarolorentedev/opencode-flowgraph.git"
  },
  "homepage": "https://github.com/alvarolorentedev/opencode-flowgraph#readme",
  "bugs": {
    "url": "https://github.com/alvarolorentedev/opencode-flowgraph/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
